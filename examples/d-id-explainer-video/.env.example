# Your Shotstack API key: https://dashboard.shotstack.io
SHOTSTACK_API_KEY=

# Optional. Set to stage for free watermarked test renders (use your sandbox key).
SHOTSTACK_ENV=

# Your D-ID API key, pasted exactly as shown: https://studio.d-id.com -> Account Settings
DID_API_KEY=

# A public https link to a front-facing photo of the presenter (jpg or png)
PRESENTER_IMAGE=

# Optional. A Microsoft voice name: https://docs.d-id.com/reference/tts-microsoft
DID_VOICE=

# Optional. Text on the title card and the end card.
TITLE=
END_CARD=
