# Your Shotstack API key: https://dashboard.shotstack.io
SHOTSTACK_API_KEY=

# Optional. Set to stage for free watermarked test renders (use your sandbox key).
SHOTSTACK_ENV=

# Your Recraft API key: https://www.recraft.ai/profile/api
RECRAFT_API_KEY=

# Optional. A custom style id for brand consistency: https://www.recraft.ai/docs/api-reference/styles
RECRAFT_STYLE_ID=

# Optional. Model and base style when no style id is set: https://www.recraft.ai/docs/api-reference/endpoints
RECRAFT_MODEL=
RECRAFT_STYLE=
