# Your Shotstack API key: https://dashboard.shotstack.io
SHOTSTACK_API_KEY=

# Optional. Set to stage for free watermarked test renders (use your sandbox key).
SHOTSTACK_ENV=

# Your Deepgram API key: https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=

# A public https link to the recording (mp4, mp3 or wav)
SOURCE_VIDEO=

# Optional. Deepgram model (default nova-3): https://developers.deepgram.com/docs/models-languages-overview
DEEPGRAM_MODEL=

# Optional. Words per caption (default 6) and the chapter card colour.
CUE_WORDS=
ACCENT=
