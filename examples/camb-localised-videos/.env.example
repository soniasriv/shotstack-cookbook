# Your Shotstack API key: https://dashboard.shotstack.io
SHOTSTACK_API_KEY=

# Optional. Set to stage for free watermarked test renders (use your sandbox key).
SHOTSTACK_ENV=

# Your Camb.ai API key: https://studio.camb.ai -> API keys
CAMB_API_KEY=

# A public https link to the video to localise
SOURCE_VIDEO=

# The language spoken in the video (default en-us): https://docs.camb.ai/api-reference/endpoint/get-source-languages
SOURCE_LANGUAGE=

# Optional. Badge colour.
ACCENT=
