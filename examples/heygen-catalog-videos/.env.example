# Your Shotstack API key: https://dashboard.shotstack.io
SHOTSTACK_API_KEY=

# Optional. Set to stage for free watermarked test renders (use your sandbox key).
SHOTSTACK_ENV=

# Your HeyGen API key: https://app.heygen.com/settings -> API
HEYGEN_API_KEY=

# The avatar to use: https://app.heygen.com/avatars (or GET https://api.heygen.com/v2/avatars)
HEYGEN_AVATAR_ID=

# The voice to use: https://app.heygen.com/voices (or GET https://api.heygen.com/v2/voices)
HEYGEN_VOICE_ID=
